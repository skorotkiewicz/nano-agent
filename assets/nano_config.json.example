{
  "model": "gpt-4-turbo",
  "provider": "openrouter",
  "max_tokens": 8192,
  "temperature": 0.7,
  "custom_providers": {
    "openrouter": {
      "provider_type": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "sk-or-..."
    },
    "local": {
      "provider_type": "openai",
      "base_url": "http://localhost:1234/v1",
      "api_key": "not-needed"
    }
  },
  "quick_models": {
    "fast": {
      "provider": "openrouter",
      "model": "google/gemini-flash-1.5"
    }
  },
  "mcp_servers": {
    "semble": {
      "command": "uvx",
      "args": ["--from", "semble[mcp]", "semble"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-"
      }
    }
  }
}