{
  "model": "gpt-4-turbo",
  "provider": "openrouter",
  "max_tokens": 8192,
  "temperature": 0.7,
  "custom_providers": {
    "openrouter": {
      "provider_type": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "sk-or-..."
    },
    "local": {
      "provider_type": "openai",
      "base_url": "http://localhost:1234/v1",
      "api_key": "not-needed"
    }
  },
  "mcp_servers": {
    "semble": {
      "command": "uvx",
      "args": ["--from", "semble[mcp]", "semble"],
      "show_logs": false
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-"
      }
    }
  },
  "acp": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8643,
    "agent_name": "nano",
    "description": "Nano local shell agent",
    "api_key": "optional-server-token",
    "agents": {
      "remote-coder": {
        "endpoint": "http://localhost:8644",
        "agent_name": "coder",
        "timeout": 120,
        "api_key": "optional-remote-token"
      }
    }
  }
}
